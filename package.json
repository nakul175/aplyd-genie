{
  "name": "aplyd-genie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "worker:exports": "node --env-file-if-exists=.env src/export-worker.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "openid-client": "6.8.9",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "jose": "6.2.15"
  }
}
