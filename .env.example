# Supply real values through the deployment secret manager. Never commit .env.
DATABASE_URL=postgresql://genie:REPLACE@127.0.0.1:5432/genie
PORT=3000
# Only with a local ingress that overwrites X-Forwarded-For.
GENIE_TRUST_PROXY=loopback
GENIE_ORIGIN=https://staging.genie.aplyd.org
GENIE_IDENTITY_ISSUER=https://accounts.aplyd.org
# Proposed client ID; registration and reviewed local identity links are required.
GENIE_OIDC_CLIENT_ID=aplyd-genie-staging
GENIE_OIDC_CLIENT_SECRET=
# Canonical base64 encoding of 32 random bytes; retain across process restarts.
GENIE_SESSION_KEY=
